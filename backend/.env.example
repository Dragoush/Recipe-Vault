DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recipes_db
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recipes_db_test
AUTH_JWT_SECRET_KEY=change-me-before-deploying
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=604800
AUTH_SESSION_INACTIVITY_TTL_SECONDS=1800
AUTH_REFRESH_COOKIE_NAME=recipe_vault_refresh_token
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAMESITE=none
AUTH_REFRESH_COOKIE_PATH=
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=false
BACKEND_SSL_CERTFILE=
BACKEND_SSL_KEYFILE=
PASSWORD_HASH_ITERATIONS=200000
